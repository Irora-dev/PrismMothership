# Prism Mothership — environment variables (the by-hand setup path; the wizard
# node create/index.mjs and the /setup studio write these for you)
#
# The site runs in DEMO mode out of the box (a continuous, realistic simulated
# activity stream). The moment you set a mainnet RPC below it switches to reading
# REAL on-chain activity — no code change needed.
#
# On Netlify: add these under Site configuration → Environment variables.
# NEVER commit real values — keep them in .env (gitignored) or the Netlify UI.

# ── Live data (the only thing you need) ──────────────────────────────────────
# One Alchemy key powers BOTH Ethereum and Base. The eth-mainnet and base-mainnet
# Alchemy endpoints are built from it, so enable both networks on the key.
ALCHEMY_API_KEY=

# ── Optional RPC overrides (take precedence over the Alchemy key) ─────────────
RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=

# ── Optional: live contract-verification badges on /contracts ────────────────
ETHERSCAN_API_KEY=

# ── Your canonical https URL (share images; most hosts set URL automatically) ─
URL=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Force a mode regardless of RPC presence: "live" | "demo"
FEED_MODE=
# Server refresh intervals, ms (how often the feed/stats re-read the chain)
LIVE_REFRESH_MS=
STATS_REFRESH_MS=
# Client poll interval, ms (exposed to the browser)
NEXT_PUBLIC_LIVE_POLL_MS=
# Block-explorer bases for tx / address links
NEXT_PUBLIC_EXPLORER_URL=https://etherscan.io
NEXT_PUBLIC_BASE_EXPLORER_URL=https://basescan.org

# ── Auto-share bot (Telegram + X) — all optional; dormant unless set ──
# Master switch — the bot posts NOTHING until this is "1" (or "true").
SOCIAL_ENABLED=
# Preview mode: build the posts and return them from /api/social/tick?dry=1
# without posting or advancing the watermark. Set "1" to preview safely.
SOCIAL_DRY_RUN=
# Shared secret guarding /api/social/tick (the scheduled fn sends it).
SOCIAL_TICK_SECRET=
# Telegram: @BotFather token + chat id(s) the bot is admin of.
# TELEGRAM_CHAT_ID may be a COMMA-SEPARATED list to post to several chats
# (e.g. the burns channel + the main Prism group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# X (Twitter) OAuth 1.0a — from the @prism_lp developer app (write access).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Optional knobs: max posts per 5-min pass (default 4); on first run, ignore
# events older than this many minutes so it doesn't blast history (default 30).
SOCIAL_MAX_PER_TICK=
SOCIAL_COLD_LOOKBACK_MIN=
