# Prism Mothership — environment variables (the by-hand setup path; the wizard
# `node create/index.mjs` and the /setup studio write these for you).
#
# ONLY the two uncommented lines below are needed. Every other setting is an
# optional override — uncomment a line only if you actually want to change it.
# (Deploy-form note: automated deploy flows read this file's ACTIVE lines as
# required fields, which is why the optional knobs ship commented out.)
#
# The site runs in DEMO mode out of the box (a continuous, realistic simulated
# activity stream). The moment you set a mainnet RPC below it switches to reading
# REAL on-chain activity — no code change needed.
#
# On your host, set these same names in the platform's env-var UI (Netlify: Site
# configuration → Environment variables · Cloudflare: Worker → Settings →
# Variables and Secrets). NEVER commit real values.

# ── Live data (the only thing you need) ──────────────────────────────────────
# One Alchemy key powers Ethereum, Base AND Robinhood Chain reads (the per-chain
# endpoints are built from it — enable those networks on the key).
# ⚠ Do NOT add an "Allowed Domains" restriction to this key in Alchemy: that
# matches the browser Origin header, and this kit calls Alchemy from the SERVER,
# which sends none — any domain allowlist therefore blocks 100% of your own
# traffic and the site's stats go dark. The key never reaches the browser, which
# is the protection; for a hard limit use Alchemy's monthly usage cap instead.
ALCHEMY_API_KEY=

# ── Your canonical https URL (share images; some hosts set URL automatically) ─
URL=

# ── Optional RPC overrides (take precedence over the Alchemy key) ─────────────
# RPC_URL=              e.g. https://eth-mainnet.g.alchemy.com/v2/<key>
# BASE_RPC_URL=         e.g. https://base-mainnet.g.alchemy.com/v2/<key>
# ROBINHOOD_RPC_URL=    defaults to the public https://rpc.mainnet.chain.robinhood.com/rpc

# ── Optional: live contract-verification badges on /contracts ────────────────
# ETHERSCAN_API_KEY=

# ── Trading surface ────────────────────────────────────────────────────────────
# "matcha" (default): /trade is read-only and links out to execute.
# "native": the full in-page ETH->PRISM swap runs on YOUR instance (it takes no
# cut and holds no funds; visitors sign their own transactions). Read
# DISCLAIMER.md before enabling. Overrides site.config.json; read at BUILD time.
# TRADING_MODE=matcha

# ── Radio source ──────────────────────────────────────────────────────────────
# With no local tracks the radio streams another Mothership's playlist.
# RADIO_SOURCE_URL=https://prismbeat.xyz    ("off" disables; local files win)

# ── Optional tuning ──────────────────────────────────────────────────────────
# Force a mode regardless of RPC presence: "live" | "demo"
# FEED_MODE=
# Server refresh intervals, ms (how often the feed/stats re-read the chain)
# LIVE_REFRESH_MS=20000
# STATS_REFRESH_MS=30000
# How long one request waits for the cold chain scan before serving empty
# (Cloudflare Workers deploys get 25000 from wrangler.jsonc automatically)
# FEED_EVENTS_BUDGET_MS=7000
# FEED_STATS_BUDGET_MS=6000
# Client poll interval, ms (exposed to the browser)
# NEXT_PUBLIC_LIVE_POLL_MS=10000
# Block-explorer bases for tx / address links
# NEXT_PUBLIC_EXPLORER_URL=https://etherscan.io
# NEXT_PUBLIC_BASE_EXPLORER_URL=https://basescan.org

# ── Auto-share bot (Telegram + X) — optional; fully dormant unless enabled ────
# The bot posts NOTHING until SOCIAL_ENABLED is "1" (or "true"). Its scheduler
# ships as a Netlify function; on other hosts add a cron hitting /api/social/tick
# with the shared secret.
# SOCIAL_ENABLED=0
# SOCIAL_DRY_RUN=0
# SOCIAL_TICK_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=       comma-separated list allowed (several chats)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# SOCIAL_MAX_PER_TICK=4
# SOCIAL_COLD_LOOKBACK_MIN=30
